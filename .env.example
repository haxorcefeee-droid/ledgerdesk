# Required on Vercel. Neon/Vercel Storage may set POSTGRES_URL instead.
# Local `npm run dev` uses SQLite in data/ if neither is set.
DATABASE_URL=
POSTGRES_URL=

# Required to lock the public site. Local dev stays open if unset.
LEDGERDESK_PASSWORD=

# Optional. Used to sign the session cookie. Falls back to LEDGERDESK_PASSWORD.
AUTH_SECRET=
